---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { url } from "../../utils/url-utils";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import TOC from "./TOC.astro";

interface Props {
  class?: string;
  headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const headings = Astro.props.headings ?? [];
const isPostPage = Astro.url.pathname.startsWith(url("/posts/"));
const postPathPrefix = url("/posts/");
---
<div id="sidebar" class:list={[className, "w-full"]}>
  <div
    id="sidebar-profile"
    class:list={["flex flex-col w-full gap-4 mb-4", { "hidden": isPostPage }]}
  >
    <Profile></Profile>
  </div>
  <div
    id="sidebar-sticky"
    class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4"
  >
    <Categories
      class="onload-animation"
      style="animation-delay: 150ms"
    ></Categories>
    {siteConfig.toc.enable && (
      <div
        id="toc-wrapper"
        class:list={[
          "onload-animation card-base pb-4",
          { "toc-hide": siteConfig.banner.enable },
          { "hidden": !isPostPage },
        ]}
        style="animation-delay: 200ms"
      >
        <div
          class="
            font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-8 mt-4 mb-2
            before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
            before:absolute before:left-[-16px] before:top-[5.5px]
          "
        >
          {i18n(I18nKey.tableOfContents)}
        </div>
        <div
          id="toc-inner-wrapper"
          class="px-2 w-full"
        >
          <div id="toc" class="w-full transition-swup-fade">
            <TOC headings={headings} />
          </div>
        </div>
      </div>
    )}
    {!siteConfig.toc.enable && <div id="toc"></div>}
  </div>
</div>

<script define:vars={{ postPathPrefix }}>
function updateSidebarVisibility() {
  const isPost = window.location.pathname.startsWith(postPathPrefix);
  const profile = document.getElementById("sidebar-profile");
  const tocWrapper = document.getElementById("toc-wrapper");

  if (profile) profile.classList.toggle("hidden", isPost);
  if (tocWrapper) tocWrapper.classList.toggle("hidden", !isPost);
}

updateSidebarVisibility();

if (window.swup) {
  window.swup.hooks.on("page:view", updateSidebarVisibility);
} else {
  document.addEventListener("swup:enable", () => {
    window.swup.hooks.on("page:view", updateSidebarVisibility);
  });
}
</script>
